{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projects",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": { "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } } },
  "$defs": {
    "decisionCurve": {
      "description": "A decision curve with a threshold slider. Both numbers shape the sample curves. Neither is data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "caption", "prevalence", "separation", "axes", "lines"],
      "properties": {
        "kind": { "const": "decision-curve" },
        "caption": { "type": "string", "minLength": 1 },
        "prevalence": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "separation": { "type": "number", "exclusiveMinimum": 0 },
        "axes": { "$ref": "#/$defs/axes" },
        "lines": { "type": "object", "additionalProperties": false, "required": ["model", "all", "none"], "properties": { "model": { "type": "string" }, "all": { "type": "string" }, "none": { "type": "string" } } }
      }
    },
    "equivalence": {
      "description": "A confidence interval and its point estimate against the equivalence limits. All values are percent of the reference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "caption", "limits", "centre", "estimate", "interval", "confidence"],
      "properties": {
        "kind": { "const": "equivalence" },
        "caption": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/pair" },
        "centre": { "type": "number" },
        "estimate": { "type": "number" },
        "interval": { "$ref": "#/$defs/pair" },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "calibration": {
      "description": "Two calibration curves against perfect calibration. Each exponent bends one curve away from the diagonal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "caption", "reference", "axes", "groups"],
      "properties": {
        "kind": { "const": "calibration" },
        "caption": { "type": "string", "minLength": 1 },
        "reference": { "type": "string" },
        "axes": { "$ref": "#/$defs/axes" },
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "object", "additionalProperties": false, "required": ["label", "exponent"], "properties": { "label": { "type": "string" }, "exponent": { "type": "number", "exclusiveMinimum": 0 } } }
        }
      }
    },
    "axes": { "description": "The names of the two axes of an illustration.", "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "string" }, "y": { "type": "string" } } },
    "pair": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "scope"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^https://[^ ]+$" },
        "scope": { "enum": ["first-party", "external"] }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do"],
      "properties": {
        "do": { "enum": ["wait", "click", "type", "clear"] },
        "target": { "type": "string", "pattern": "^[a-zA-Z]+$" },
        "ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "delayMs": { "type": "integer", "minimum": 0 }
      }
    },
    "clip": {
      "description": "A silent looping recording of the live demo. `capture.clip` is the crop area of the still, not this object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mp4", "webm", "width", "height", "fps", "seconds", "maxKilobytes", "quality", "scene"],
      "properties": {
        "mp4": { "type": "string", "pattern": "^assets/video/[a-z0-9-]+\\.mp4$" },
        "webm": { "type": "string", "pattern": "^assets/video/[a-z0-9-]+\\.webm$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "seconds": { "type": "integer", "minimum": 6, "maximum": 9 },
        "maxKilobytes": { "type": "integer", "minimum": 1 },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mp4Crf", "webmCrf"],
          "properties": { "mp4Crf": { "type": "integer", "minimum": 0, "maximum": 51 }, "webmCrf": { "type": "integer", "minimum": 0, "maximum": 63 } }
        },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "steps"],
          "properties": {
            "targets": { "type": "object", "additionalProperties": { "type": "string" } },
            "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/step" } }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "kind", "status", "summary", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "tier": { "enum": ["featured", "more"] },
        "kind": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "live": { "type": "boolean" },
        "lead": { "type": "boolean" },
        "downloads": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "instruments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "steps"],
          "properties": { "label": { "type": "string" }, "steps": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 4 } }
        },
        "illustration": { "oneOf": [{ "$ref": "#/$defs/decisionCurve" }, { "$ref": "#/$defs/equivalence" }, { "$ref": "#/$defs/calibration" }] },
        "points": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary"],
          "properties": { "primary": { "$ref": "#/$defs/link" }, "secondary": { "type": "array", "items": { "$ref": "#/$defs/link" } }, "learn": { "$ref": "#/$defs/link" } }
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "ink", "accent", "host"],
          "properties": { "surface": { "$ref": "#/$defs/color" }, "ink": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "host": { "type": "string" } }
        },
        "clip": { "$ref": "#/$defs/clip" },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "width", "height", "alt"],
          "properties": { "file": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "alt": { "type": "string" } }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "width", "height", "clip"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "clip": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "width": { "type": "integer" }, "height": { "type": "integer" } }
            }
          }
        },
        "backlink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "placement"],
          "properties": { "text": { "type": "string" }, "placement": { "type": "string" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "featured" } } },
          "then": {
            "required": ["look", "preview", "clip", "capture", "backlink", "points", "note"],
            "properties": { "look": true, "preview": true, "clip": true, "capture": true, "backlink": true, "points": true, "note": true }
          }
        },
        {
          "if": { "properties": { "lead": { "const": true } }, "required": ["lead"] },
          "then": { "required": ["note"], "properties": { "tier": { "const": "more" }, "note": true } }
        },
        {
          "if": { "properties": { "tier": { "const": "more" } } },
          "then": { "required": ["illustration"], "properties": { "illustration": true } }
        }
      ]
    }
  }
}
