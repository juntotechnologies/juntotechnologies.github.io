{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projects",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": { "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } } },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "scope"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^https://[^ ]+$" },
        "scope": { "enum": ["first-party", "external"] }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "kind", "status", "summary", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "tier": { "enum": ["featured", "more"] },
        "kind": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "instruments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "points": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary"],
          "properties": { "primary": { "$ref": "#/$defs/link" }, "secondary": { "type": "array", "items": { "$ref": "#/$defs/link" } } }
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "ink", "accent", "host"],
          "properties": { "surface": { "$ref": "#/$defs/color" }, "ink": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "host": { "type": "string" } }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "width", "height", "alt"],
          "properties": { "file": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "alt": { "type": "string" } }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "width", "height", "clip"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "clip": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "width": { "type": "integer" }, "height": { "type": "integer" } }
            }
          }
        },
        "backlink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "placement"],
          "properties": { "text": { "type": "string" }, "placement": { "type": "string" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "featured" } } },
          "then": {
            "required": ["look", "preview", "capture", "backlink", "points", "note"],
            "properties": { "look": true, "preview": true, "capture": true, "backlink": true, "points": true, "note": true }
          }
        }
      ]
    }
  }
}
